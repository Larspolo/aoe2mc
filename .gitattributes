# Ticket runs only add lines here, so a merge keeps the new lines of both sides; the improve skill cleans up.
docs/LEARNINGS.md merge=union
docs/PITFALLS.md merge=union
# The "Pitfalls" section is the last one of these documents, and runs only add lines there (as in LEARNINGS.md).
# 21 changes of gameplay.md in 24 hours conflicted with each other at its end (#437).
docs/research/gameplay.md merge=union
docs/research/replays.md merge=union
docs/minecraft-versions.md merge=union
docs/datapack.md merge=union
docs/packaging.md merge=union
docs/research/water.md merge=union
# One line per owner decision, added at the end (ticket skill, "Decision tickets").
steering/project/DECISIONS.md merge=union
steering/system/DECISIONS.md merge=union
# The game tables merge by the key "name" (#2004): framework/tools/merge_jsonl.py, registered by .claude/hooks/session-start.sh
# and the workflow unconflict.yml. Without the driver, git merges them as text.
# One JSON object per civilization (#1914); table.load() stops on a name in two lines.
game/data/civs.jsonl merge=jsonl
# One JSON object per key of civs.jsonl: what it does, its issue (#2281).
game/data/civ_keys.jsonl merge=jsonl
# One JSON object per key of train.jsonl that train.value() reads (#2507).
game/data/train_keys.jsonl merge=jsonl
# One JSON object per key of setup.jsonl: its type, what it does, its issue (#2558).
game/data/setup_keys.jsonl merge=jsonl
# One JSON object per menu item; runs add a line at the end of a building block. train.load() stops on a name in two lines (#1702).
game/data/train.jsonl merge=jsonl
# One JSON object per unit (#1912); table.load() stops on a name in two lines.
game/data/units.jsonl merge=jsonl
# One JSON object per unit class: its select voice (#3499).
game/data/sounds.jsonl merge=jsonl
# One JSON object per building, or only a line of sight (#1913); table.load() stops on a name in two lines.
game/data/buildings.jsonl merge=jsonl
# The files of the rule set of Antiquity Mode (#3666): the same format.
game/data/antiquity/*.jsonl merge=jsonl
# One JSON object per building of the menu, or only the age or technology of a name (#2028); table.load() stops on a name in two lines.
game/data/build.jsonl merge=jsonl
# One JSON object per resource, drop site, gather technology or animal (#2033); table.load() stops on a name in two lines.
game/data/gather.jsonl merge=jsonl
# One JSON object per Art of War challenge: its civilization, goal and medal limits (#3761).
game/data/challenges.jsonl merge=jsonl
# One JSON object per cheat code with a unit, per monk rule name and per replay name (#2034); table.load() stops on a name in two lines.
game/data/cheats.jsonl merge=jsonl
game/data/monk.jsonl merge=jsonl
game/data/music.jsonl merge=jsonl
game/data/per_names.jsonl merge=jsonl
game/data/per_classes.jsonl merge=jsonl
game/data/per_object_data.jsonl merge=jsonl
game/data/per_filter_ids.jsonl merge=jsonl
game/data/per_numbers.jsonl merge=jsonl
game/data/per_resources.jsonl merge=jsonl
game/data/replay.jsonl merge=jsonl
# One JSON object per option value of the game setup (#2264); table.load() stops on a name in two lines.
game/data/setup.jsonl merge=jsonl
# One JSON object per level of "AI difficulty" of the bot (#2661).
game/data/difficulty.jsonl merge=jsonl
# One JSON object per taunt, named by its number (#2234).
game/data/taunts.jsonl merge=jsonl
game/data/texts.jsonl merge=jsonl
# One JSON object per bonus of the wiki list, named "CIV: bonus" (#2100): two tickets that close two bonuses do not conflict.
tests/data/civ_bonuses.jsonl merge=jsonl
# The converter tables (#1917): one JSON object per line; the order of animals.jsonl and footprint.jsonl matters (the first match wins).
data/*.jsonl merge=union
# The datapack text of each trigger type (tools/triggers.py MAP): runs change existing lines, so they merge by name.
data/trigger_conditions.jsonl merge=jsonl
data/trigger_effects.jsonl merge=jsonl
# The places of game data in the code (#1909): runs only delete lines or lower counts; tests/test_game_names_in_code.py
# fails on two lines of one place and on a line that a merge put back.
tests/data/game_names_in_code.txt merge=union
framework/files.txt merge=union
# One class name per unit ability of the plugin (#4589): each ability PR adds one line, ServiceLoader reads them.
game/plugin/src/main/resources/META-INF/services/aoe2mc.Ability merge=union
game/data/tutorial.jsonl merge=jsonl
