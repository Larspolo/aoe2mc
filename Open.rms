
/* An open land of grass and dirt with small forests and ponds. */
#const MY_DIRT 6
<PLAYER_SETUP>
random_placement
<LAND_GENERATION>
base_terrain DIRT
create_player_lands {
  terrain_type GRASS
  land_percent 40
  base_size 8
  clumping_factor 15
}
start_random
  percent_chance 50
  #define WET
end_random
if WET
  create_land { terrain_type WATER number_of_tiles 60 base_size 2 land_position 50 50 }
endif
<TERRAIN_GENERATION>
create_terrain FOREST {
  base_terrain GRASS
  number_of_clumps 6
  number_of_tiles 240
  set_avoid_player_start_areas
  spacing_to_other_terrain_types 1
}
create_terrain FOREST {
  base_terrain MY_DIRT
  number_of_clumps 4
  number_of_tiles 120
}
<OBJECTS_GENERATION>
create_object TOWN_CENTER { set_place_for_every_player }
