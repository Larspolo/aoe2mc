{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "disableBundledSkills": true,
  "permissions": {
    "allow": [
      "Bash(python3:*)",
      "Bash(python:*)",
      "Bash(pip install:*)",
      "Bash(ruff:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(mkdir:*)",
      "Bash(diff:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git fetch:*)",
      "Bash(git pull:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git stash:*)",
      "Bash(git worktree:*)",
      "Bash(git rev-parse:*)",
      "Bash(gh api repos/Larspolo/aoe2mc:*)",
      "Bash(gh api search/issues:*)",
      "Bash(gh issue:*)",
      "Bash(gh pr:*)",
      "Bash(gh label:*)",
      "Bash(gh run:*)",
      "Bash(gh search:*)",
      "mcp__github__issue_read",
      "mcp__github__issue_write",
      "mcp__github__add_issue_comment",
      "mcp__github__update_issue_comment",
      "mcp__github__list_issues",
      "mcp__github__search_issues",
      "mcp__github__search_pull_requests",
      "mcp__github__list_pull_requests",
      "mcp__github__pull_request_read",
      "mcp__github__create_pull_request",
      "mcp__github__update_pull_request",
      "mcp__github__merge_pull_request",
      "mcp__github__add_reply_to_pull_request_comment",
      "mcp__github__sub_issue_write",
      "mcp__github__get_label",
      "mcp__github__get_check_run",
      "mcp__github__get_job_logs",
      "mcp__github__actions_list",
      "mcp__github__actions_get",
      "mcp__github__list_commits",
      "mcp__github__get_me"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(gh repo delete:*)",
      "Artifact",
      "ArtifactComments",
      "ArtifactData",
      "CronCreate",
      "CronDelete",
      "CronList",
      "DesignSync",
      "ListConnectors",
      "ListMcpResourcesTool",
      "ListPlugins",
      "ListSkills",
      "mcp__claude-code-remote",
      "NotebookEdit",
      "PushNotification",
      "ReadMcpResourceDirTool",
      "ReadMcpResourceTool",
      "SearchMcpRegistry",
      "SearchPlugins",
      "SearchSkills",
      "SendUserFile",
      "ShowOnboardingRolePicker",
      "SuggestConnectors",
      "SuggestPluginInstall",
      "SuggestSkills",
      "Workflow"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/guard-main.sh"
          }
        ]
      }
    ]
  }
}
